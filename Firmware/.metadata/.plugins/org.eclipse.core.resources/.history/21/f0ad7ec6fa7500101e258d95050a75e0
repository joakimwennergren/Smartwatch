/* LVGL timer for tasks. */
void lvgl_timer(void* argument) {
  for(;;)
  {
    lv_timer_handler();
    vTaskDelay(pdMS_TO_TICKS(20));
  }
}

/* LVGL tick source */
void lvgl_tick(void* argument) {
  for(;;)
  {
    lv_tick_inc(10);
    vTaskDelay(pdMS_TO_TICKS(10));
  }
}

void create_lvgl_tick_task(void) {
    xTaskCreate(
        lvgl_tick,              // Task function
        "lvgl_tick",           // Name (for debugging)
        1024,                  // Stack size (words, not bytes)
        NULL,                  // Task parameter
        tskIDLE_PRIORITY + 1,  // Priority
        &lvgl_tick_handle_g       // Handle to the task
    );
}

void create_lvgl_timer_task(void) {
