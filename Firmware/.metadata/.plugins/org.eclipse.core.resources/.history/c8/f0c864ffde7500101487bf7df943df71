#include "display.hpp"
#include <cstring>

Display::Display(OSPI_HandleTypeDef hospi, DMA2D_HandleTypeDef hdma2d) : hospi_{hospi} {}

HAL_StatusTypeDef Display::CO5300_QSPI_WriteCmd(uint8_t cmd, const uint8_t *params, uint32_t param_len) {
	OSPI_RegularCmdTypeDef sCommand;
    HAL_StatusTypeDef status;

    memset(&sCommand, 0, sizeof(sCommand));

    sCommand.InstructionMode   = HAL_OSPI_INSTRUCTION_1_LINE;
    sCommand.Instruction       = 0x02; // "Write" instruction per datasheet
    sCommand.AddressMode       = HAL_OSPI_ADDRESS_1_LINE;
    sCommand.AddressSize       = HAL_OSPI_ADDRESS_24_BITS;
    // Address layout: 0x00 CMD 0x00 -> so shift cmd into the middle byte
    sCommand.Address           = ((uint32_t)cmd << 8); // 0x00 CMD 0x00
    sCommand.AlternateBytesMode = HAL_OSPI_ALTERNATE_BYTES_NONE;
    sCommand.DummyCycles       = 0;
    sCommand.DataMode          = (param_len > 0) ? HAL_OSPI_DATA_1_LINE : HAL_OSPI_DATA_NONE;
    sCommand.NbData            = param_len;
    sCommand.SIOOMode          = HAL_OSPI_SIOO_INST_EVERY_CMD;

    status = HAL_OSPI_Command(&hospi_, &sCommand, HAL_MAX_DELAY);
    if (status != HAL_OK) return status;

    if (param_len > 0) {
        status = HAL_OSPI_Transmit(&hospi_, (uint8_t *)params, HAL_MAX_DELAY);
    }
    return status;
}

HAL_StatusTypeDef Display::CO5300_SendInitSequence(void) {
    HAL_StatusTypeDef st;
    uint8_t buf[4];

    // RFE 00
    buf[0] = 0x00; st = CO5300_QSPI_WriteCmd(0xFE, buf, 1);
    if (st != HAL_OK) return st;

    // RC4 80 -- command 0xC4, param 0x80
    buf[0] = 0x80; st = CO5300_QSPI_WriteCmd(0xC4, buf, 1);
    if (st != HAL_OK) return st;

    // R3A 55 -- COLMOD -> RGB565
    buf[0] = 0x55; st = CO5300_QSPI_WriteCmd(0x3A, buf, 1);
    if (st != HAL_OK) return st;

    // R35 00
    buf[0] = 0x00; st = CO5300_QSPI_WriteCmd(0x35, buf, 1);
    if (st != HAL_OK) return st;

    // R53 20
    buf[0] = 0x20; st = CO5300_QSPI_WriteCmd(0x53, buf, 1);
    if (st != HAL_OK) return st;

    // R51 FF (brightness)
    buf[0] = 0xFF; st = CO5300_QSPI_WriteCmd(0x51, buf, 1);
    if (st != HAL_OK) return st;

    // R63 FF
    buf[0] = 0xFF; st = CO5300_QSPI_WriteCmd(0x63, buf, 1);
    if (st != HAL_OK) return st;

    // R2A 00 10 01 7F -- column: SC=0x0010, SE=0x017F
    buf[0] = 0x00; buf[1] = 0x10; buf[2] = 0x01; buf[3] = 0x7F;
    st = CO5300_QSPI_WriteCmd(0x2A, buf, 4);
    if (st != HAL_OK) return st;

    // R2B 00 00 01 BF -- row: SP=0x0000, EP=0x01BF
    buf[0] = 0x00; buf[1] = 0x00; buf[2] = 0x01; buf[3] = 0xBF;
    st = CO5300_QSPI_WriteCmd(0x2B, buf, 4);
    if (st != HAL_OK) return st;

    // R11 Sleep Out
    st = CO5300_QSPI_WriteCmd(0x11, NULL, 0);
    if (st != HAL_OK) return st;
    HAL_Delay(60);

    // R29 Display ON
    st = CO5300_QSPI_WriteCmd(0x29, NULL, 0);
    return st;
}

HAL_StatusTypeDef Display::CO5300_EnterMemoryMapped(void) {
    HAL_StatusTypeDef status;
    OSPI_RegularCmdTypeDef sCommand;
    OSPI_MemoryMappedTypeDef memMappedCfg;

    memset(&sCommand, 0, sizeof(sCommand));
    memset(&memMappedCfg, 0, sizeof(memMappedCfg));

    /* Build command */
    sCommand.InstructionMode   = HAL_OSPI_INSTRUCTION_1_LINE;
    sCommand.Instruction       = 0x32;
    sCommand.AddressMode       = HAL_OSPI_ADDRESS_4_LINES;
    sCommand.AddressSize       = HAL_OSPI_ADDRESS_24_BITS;
    sCommand.Address           = 0x002C00;
    sCommand.DataMode          = HAL_OSPI_DATA_4_LINES;
    sCommand.DummyCycles       = 0;
    sCommand.SIOOMode          = HAL_OSPI_SIOO_INST_EVERY_CMD;

    /* Send regular command first */
    status = HAL_OSPI_Command(&hospi_, &sCommand, HAL_OSPI_TIMEOUT_DEFAULT_VALUE);
    if (status != HAL_OK)
        return status;

    /* Configure memory-mapped parameters */
    memMappedCfg.TimeOutActivation = HAL_OSPI_TIMEOUT_COUNTER_DISABLE;
    memMappedCfg.TimeOutPeriod = 0;

    /* Enter memory mapped mode */
    status = HAL_OSPI_MemoryMapped(&hospi_, &memMappedCfg);

    return status;
}

void Display::CO5300_WriteFrameRGB565(const uint8_t *frame_rgb565) {
    // QSPI memory must be in memory-mapped mode. Then writing to the QSPI memory base
    // will stream data to the display via the configured 4-line pixel write command.
    // Copy size should equal panel size (FRAMEBUFFER_SIZE).
    volatile void *qmem = (volatile void *)QSPI_MEM_BASE;
    // Use platform-appropriate memcpy; simple loop avoids large stack usage
    uint32_t i;
    const uint8_t *src = frame_rgb565;
    uint8_t *dst = (uint8_t *)qmem;

    for (i = 0; i < FRAMEBUFFER_SIZE; ++i) {
        dst[i] = src[i];
    }
}

void Display::CO5300_WriteFrameRGB565_DMA2D(const uint8_t *frame_rgb565, uint32_t width, uint32_t height) {
    // Destination address: QSPI memory mapped display
    uint32_t dst_address = (uint32_t)QSPI_MEM_BASE;

    // Source address
    uint32_t src_address = (uint32_t)frame_rgb565;

    // Configure the DMA2D peripheral
    hdma2d.Init.Mode          = DMA2D_M2M;                // Memory to Memory transfer
    hdma2d.Init.ColorMode     = DMA2D_OUTPUT_RGB565;      // Destination format (RGB565)
    hdma2d.Init.OutputOffset  = 0;                        // No offset in destination line (contiguous)
    hdma2d.LayerCfg[1].InputColorMode = DMA2D_INPUT_RGB565; // Source format (RGB565)
    hdma2d.LayerCfg[1].InputOffset    = 0;                // No offset in source line
    hdma2d.Instance = DMA2D;

    if (HAL_DMA2D_Init(&hdma2d) != HAL_OK) {
        // Initialization Error
        Error_Handler();
    }

    if (HAL_DMA2D_ConfigLayer(&hdma2d, 1) != HAL_OK) {
        // Configuration Error
        Error_Handler();
    }

    // Start DMA2D transfer: width = number of pixels per line, height = lines
    // Since RGB565 is 2 bytes per pixel, no adjustment needed in DMA2D start call
    if (HAL_DMA2D_Start(&hdma2d, src_address, dst_address, width, height) != HAL_OK) {
        // Transfer Error
        Error_Handler();
    }

    // Optionally, wait for transfer complete (blocking)
    if (HAL_DMA2D_PollForTransfer(&hdma2d, HAL_MAX_DELAY) != HAL_OK) {
        // Transfer Polling Error
        Error_Handler();
    }
}

